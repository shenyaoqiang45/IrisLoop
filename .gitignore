__pycache__/
*.py[cod]
.venv/
venv/

# Local capture dumps; keep the published loop_rounds sample tracked
captures/*
!captures/loop_rounds/
!captures/loop_rounds/**
*.log

# Benchmark: track still JPGs + JSON; keep videos local
benchmark/**/*.mp4
benchmark/**/*.avi
benchmark/**/*.mov

# Experience officer: keep raw laser footage local; notes can be committed
experience/laser-log/**/*.mp4
experience/laser-log/**/*.mov
experience/laser-log/**/*.avi
experience/laser-log/**/*.raw
experience/iteration-log/private/

# Office lock files
~$*

# Protocol workbook internals; keep X / social post PNGs in doc/ tracked
doc/*
!doc/*.png

# Raw vendor protocol dump (Chinese source workbook extract)
tools/ble_protocol_dump.txt

# Reverse-engineering scratch (Flutter copies / SDK extracts / decompilers)
tmp/
